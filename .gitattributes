# ------------------------------------------------------------------------------
# GitHub Linguist Configuration
# Hides frontend CSS/HTML from language statistics and highlights Cybersecurity/Scripting
# ------------------------------------------------------------------------------

*.css linguist-vendored
*.html linguist-vendored
styles.css linguist-vendored
script.js linguist-vendored

# Ensure Shell and Python scripts are detected as the core repository languages
scripts/*.sh linguist-detectable=true
scripts/*.py linguist-detectable=true
*.sh linguist-detectable=true
*.py linguist-detectable=true
